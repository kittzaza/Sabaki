/engines/

dist/
# The coach engine is built from its own repository and staged here before
# packaging (scripts/stageCoachEngine.js), never committed.
build/coach/thai-go-coach*
# Upstream generates these into the @sabaki/i18n package and keeps none of them
# here. This fork ships its own Thai file, and keeps the extracted English list
# beside it because test/i18nThTests.js checks the translation against it.
i18n/*
!i18n/en.i18n.js
!i18n/th.i18n.js
node_modules/

bundle.js
bundle.js.LICENSE.txt
bundle.js.map

*.pdn
*.vbs

playwright-report/
test-results/

# Engine integration test cache (downloaded nets, gtp configs)
.engine-cache/

# GTP communication logs written at runtime when engines are attached
gtp_logs/
